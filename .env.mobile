# 모바일(Capacitor) 빌드 전용 환경변수 — `vite build --mode mobile` 이 이 파일을 읽음.
#
# Railway 백엔드 (웹 프론트가 쓰는 Vercel VITE_API_BASE_URL 과 동일한 주소).
# 앱은 기기에서 실행되므로 localhost 는 절대 접속 불가. 반드시 https.
VITE_API_BASE_URL=https://butter-backend-production.up.railway.app

# 공유 링크에 쓸 공개 웹 주소.
# ⚠️ 앱에서 window.location.origin 은 WebView 내부 주소(https://localhost)라
#    그대로 공유하면 받는 사람이 열 수 없다. 반드시 실제 웹 주소를 넣을 것.
VITE_PUBLIC_WEB_URL=https://butter-black.vercel.app
