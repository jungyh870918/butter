<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12(API 31)+ 전용 스플래시.

  ⚠️ Android 12부터는 OS가 스플래시를 가져가며 풀블리드 이미지를 쓸 수 없다.
     "단색 배경 + 중앙 원형 아이콘" 조합만 허용된다.
     drawable/splash_icon.png 는 1152×1152 투명 배경이지만
     실제로는 가운데 원(지름 ~768px)만 보이므로 심볼(B)만 넣었다.
     → iOS 스플래시(워드마크 "Butter")와 100% 동일하게는 만들 수 없음. 톤만 맞춤.
-->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
