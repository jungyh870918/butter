# 이 파일을 android/keystore.properties 로 복사한 뒤 실제 값을 채울 것.
# ⚠️ keystore.properties 와 .keystore 파일은 절대 커밋하지 말 것 (.gitignore 처리됨).
# ⚠️ keystore 를 분실하면 이 앱은 영영 업데이트할 수 없다. 만들자마자 레포 밖 2곳 이상에 백업.
#
# keystore 생성:
#   keytool -genkey -v -keystore butter-release.keystore \
#     -alias butter -keyalg RSA -keysize 2048 -validity 10000

storeFile=../butter-release.keystore
storePassword=여기에_스토어_비밀번호
keyAlias=butter
keyPassword=여기에_키_비밀번호
